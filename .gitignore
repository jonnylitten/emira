node_modules/
*.log
.DS_Store

# Claude Code's local-user settings, scheduled-task locks, etc.
.claude/

# Note: dist/ IS tracked — it's a shipping artifact for the plugin
# (Claude Code runs ${CLAUDE_PLUGIN_ROOT}/dist/server.js).

# OmniParser local install artifacts — recreated by scripts/setup-omniparser.sh
# (which also re-applies our patches to OmniParser/util/utils.py).
omniparser/.venv/
omniparser/OmniParser/

# Local smoke-test output / scratch
/tmp/emira/

# Claude Code auto-memory (per-machine user state)
memory/

# Guard: literal `${...}` paths that appear when env-var substitution fails.
# This caught us once when plugin.json self-referenced CLAUDE_PLUGIN_DATA;
# even after fixing that, keep the pattern ignored so any future template
# accident creates a gitignored dir rather than 70 chromium-cache files.
${*}/

# secrets
.env
.env.*
